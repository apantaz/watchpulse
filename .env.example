# TMDB API v3 key. Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Root of the local Parquet lake (kept out of git; see .gitignore).
LAKE_ROOT=data/lake
DATABASE_PATH=data/warehouse.duckdb

# Product defaults. Regions use ISO 3166-1 alpha-2 codes.
DEFAULT_REGION=GR
SUPPORTED_REGIONS=GR
SUPPORTED_PROVIDERS=netflix,disney_plus,prime_video,apple_tv_plus

# Discovery windows (days).
NEW_RELEASE_DAYS=90
RECENTLY_ADDED_DAYS=30
LEAVING_SOON_DAYS=30
