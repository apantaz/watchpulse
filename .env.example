# TMDB API v3 key. Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Movie of the Night Streaming Availability API v4.
# Sized for a twice-weekly catalog refresh: ~8-9 runs/month x 80 requests
# stays comfortably under the monthly cap below. Lower it if the refresh
# cadence increases, or the monthly cap will start getting exhausted early.
STREAMING_AVAILABILITY_API_KEY=
STREAMING_AVAILABILITY_BASE_URL=https://api.movieofthenight.com/v4
STREAMING_AVAILABILITY_MAX_REQUESTS_PER_RUN=80
STREAMING_AVAILABILITY_MONTHLY_CAP=900

# Root of the local Parquet lake (kept out of git; see .gitignore).
LAKE_ROOT=data/lake
DATABASE_PATH=data/warehouse.duckdb
WATCHPULSE_SERVING_DB_PATH=data/warehouse_serving.duckdb
WATCHPULSE_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Product defaults. Regions use ISO 3166-1 alpha-2 codes.
DEFAULT_REGION=GR
SUPPORTED_REGIONS=GR
SUPPORTED_PROVIDERS=netflix,disney_plus,prime_video,apple_tv_plus

# Discovery windows (days).
NEW_RELEASE_DAYS=90
RECENTLY_ADDED_DAYS=30
LEAVING_SOON_DAYS=30

# Bounded TMDB enrichment policy. Backfills can override max titles explicitly.
TMDB_ENRICHMENT_MAX_TITLES_PER_RUN=250
TMDB_ENRICHMENT_UPCOMING_REFRESH_DAYS=7
TMDB_ENRICHMENT_RECENT_REFRESH_DAYS=30
TMDB_ENRICHMENT_SERIES_REFRESH_DAYS=90
TMDB_ENRICHMENT_MOVIE_REFRESH_DAYS=180
TMDB_ENRICHMENT_PROVIDER_REFRESH_DAYS=60
